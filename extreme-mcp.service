[Unit]
Description=Read-only Extreme Networks MCP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=extreme-mcp
Group=extreme-mcp
WorkingDirectory=/opt/extreme-mcp
EnvironmentFile=/etc/extreme-mcp/extreme-mcp.env
# Secrets are loaded by systemd and exposed only to this service via $CREDENTIALS_DIRECTORY.
LoadCredential=snmp_username:/etc/extreme-mcp/credentials/snmp_username
LoadCredential=snmp_auth_password:/etc/extreme-mcp/credentials/snmp_auth_password
LoadCredential=snmp_priv_password:/etc/extreme-mcp/credentials/snmp_priv_password
# Only if some switches are marked snmp_security: noauth in the inventory: create this file, then uncomment.
#LoadCredential=snmp_noauth_username:/etc/extreme-mcp/credentials/snmp_noauth_username
# Phase 2 (SSH): uncomment and create these files.
#LoadCredential=ssh_username:/etc/extreme-mcp/credentials/ssh_username
#LoadCredential=ssh_password:/etc/extreme-mcp/credentials/ssh_password
ExecStart=/opt/extreme-mcp/venv/bin/python -m app.main
Restart=on-failure
RestartSec=10
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/log/extreme-mcp

[Install]
WantedBy=multi-user.target
