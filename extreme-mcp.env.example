MCP_BIND_ADDRESS=127.0.0.1
MCP_PORT=8000
INVENTORY_FILE=/etc/extreme-mcp/inventory.yaml
AUDIT_LOG=/var/log/extreme-mcp/audit.log
SNMP_TIMEOUT_SECONDS=5
SNMP_RETRIES=1
SNMP_AUTH_PROTOCOL=sha
SNMP_PRIV_PROTOCOL=aes
SSH_ENABLED=false
SSH_KNOWN_HOSTS=/etc/extreme-mcp/known_hosts
SSH_CONNECT_TIMEOUT_SECONDS=8
SSH_COMMAND_TIMEOUT_SECONDS=20
SSH_MAX_PARALLEL=5
LOG_LEVEL=INFO
# Secrets: provide SNMP_USERNAME, SNMP_AUTH_PASSWORD and SNMP_PRIV_PASSWORD (and SSH_USERNAME + SSH_PASSWORD or SSH_KEY_FILE) through systemd credentials / the
# secret store. Never put them in this file, the repo, or shell history.
